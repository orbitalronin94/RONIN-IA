  "note_public_domain_basis": "PUBLIC-DOMAIN-ES-ART13 is a Spanish legal-basis identifier, not a license. It is allowed as a Level-B recorded basis; Level A requires the exact work/edition evidence, human legal sign-off and explicit ES/EU/US clearance.",
  "library_training_allowed_only_if_global_g0_passes": true
