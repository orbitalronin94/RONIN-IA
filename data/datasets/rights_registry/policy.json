{
  "schema_version": "1.0",
  "policy_id": "RONIN-RIGHTS-A-1",
  "policy_scope": "model_training_and_corpus_redistribution",
  "jurisdictions": [
    "ES",
    "EU",
    "US"
  ],
  "accepted_license_ids": [
    "CC0-1.0",
    "CC-BY-2.0",
    "CC-BY-3.0",
    "CC-BY-4.0",
    "MIT",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause"
  ],
  "excluded_license_classes": [
    "NC",
    "ND",
    "ShareAlike",
    "unknown",
    "mixed",
    "noncommercial",
    "no_derivatives"
  ],
  "required_evidence": [
    "source_item_id",
    "source_version",
    "source_url",
    "rights_statement_uri",
    "license_id",
    "license_uri",
    "rights_holder_or_provider",
    "rights_assertion_scope",
    "attribution",
    "retrieved_at",
    "metadata_snapshot_sha256",
    "payload_sha256",
    "provenance_uri",
    "third_party_content_review",
    "jurisdictions_cleared"
  ],
  "automatic_public_domain": false,
  "provider_assertion_is_ownership_proof": false,
  "level_a_requires_human_legal_signoff_for_public_domain": true,
  "admission_requires": [
    "rights_level_A",
    "quality_pass",
    "privacy_pass",
    "dedup_pass",
    "split_integrity_pass",
    "attribution_bundle"
  ],
  "training_allowed_only_if_global_g0_passes": true
}
