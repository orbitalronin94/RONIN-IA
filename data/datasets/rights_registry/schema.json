{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/orbitalronin94/RONIN-IA/blob/main/data/datasets/rights_registry/schema.json",
  "title": "RONIN rights evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "source_id",
    "source_item_id",
    "source_version",
    "source_url",
    "rights_statement_uri",
    "license_id",
    "license_uri",
    "rights_holder_or_provider",
    "rights_assertion_scope",
    "attribution",
    "retrieved_at",
    "metadata_snapshot_sha256",
    "payload_sha256",
    "provenance_uri",
    "third_party_content_review",
    "jurisdictions_cleared",
    "rights_level",
    "decision_reason",
    "policy_version"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_item_id": {
      "type": "string",
      "minLength": 1
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "rights_statement_uri": {
      "type": "string",
      "format": "uri"
    },
    "license_id": {
      "type": "string",
      "minLength": 1
    },
    "license_uri": {
      "type": "string",
      "format": "uri"
    },
    "rights_holder_or_provider": {
      "type": "string",
      "minLength": 1
    },
    "rights_assertion_scope": {
      "type": "string",
      "enum": [
        "exact_text_and_version",
        "exact_metadata_file_and_version",
        "exact_work_and_edition",
        "collection_only",
        "unknown"
      ]
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance_uri": {
      "type": "string",
      "format": "uri"
    },
    "third_party_content_review": {
      "type": "string",
      "enum": [
        "clear",
        "excluded_or_separately_cleared",
        "pending",
        "unknown"
      ]
    },
    "jurisdictions_cleared": {
      "type": "array",
      "items": {
        "enum": [
          "ES",
          "EU",
          "US"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "public_domain_evidence_uri": {
      "type": "string",
      "format": "uri"
    },
    "human_legal_signoff": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "not_applicable"
      ]
    },
    "rights_level": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "decision_reason": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "const": "RONIN-RIGHTS-A-1"
    }
  }
}
