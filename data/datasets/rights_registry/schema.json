{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/orbitalronin94/RONIN-IA/blob/main/data/datasets/rights_registry/schema.json",
  "title": "RONIN rights evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "source_id",
    "source_item_id",
    "source_version",
    "source_url",
    "rights_statement_uri",
    "license_id",
    "license_uri",
    "rights_holder_or_provider",
    "rights_assertion_scope",
    "attribution",
    "retrieved_at",
    "metadata_snapshot_sha256",
    "payload_sha256",
    "provenance_uri",
    "third_party_content_review",
    "jurisdictions_cleared",
    "rights_level",
    "decision_reason",
    "policy_version"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_item_id": {
      "type": "string",
      "minLength": 1
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "rights_statement_uri": {
      "type": "string",
      "format": "uri"
    },
    "license_id": {
      "type": "string",
      "minLength": 1
    },
    "license_uri": {
      "type": "string",
      "format": "uri"
    },
    "rights_holder_or_provider": {
      "type": "string",
      "minLength": 1
    },
    "rights_assertion_scope": {
      "type": "string",
      "enum": [
        "exact_text_and_version",
        "exact_metadata_file_and_version",
        "exact_work_and_edition",
        "collection_only",
        "unknown"
      ]
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance_uri": {
      "type": "string",
      "format": "uri"
    },
    "third_party_content_review": {
      "type": "string",
      "enum": [
        "clear",
        "excluded_or_separately_cleared",
        "pending",
        "unknown"
      ]
    },
    "jurisdictions_cleared": {
      "type": "array",
      "items": {
        "enum": [
          "ES",
          "EU",
          "US"
        ]
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "public_domain_evidence_uri": {
      "type": "string",
      "format": "uri",
      "description": "For public-domain-basis records, exact evidence for the named work and edition; required for Level A."
    },
    "human_legal_signoff": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "not_applicable"
      ],
      "description": "Required and must be approved before a public-domain-basis record can be Level A."
    },
    "rights_level": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "decision_reason": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "const": "RONIN-RIGHTS-A-1"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "rights_level": {
            "const": "A"
          },
          "license_id": {
            "const": "PUBLIC-DOMAIN-ES-ART13"
          }
        },
        "required": [
          "rights_level",
          "license_id"
        ]
      },
      "then": {
        "required": [
          "public_domain_evidence_uri",
          "human_legal_signoff"
        ],
        "properties": {
          "rights_assertion_scope": {
            "const": "exact_work_and_edition"
          },
          "human_legal_signoff": {
            "const": "approved"
          },
          "jurisdictions_cleared": {
            "allOf": [
              {
                "contains": {
                  "const": "ES"
                }
              },
              {
                "contains": {
                  "const": "EU"
                }
              },
              {
                "contains": {
                  "const": "US"
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rights_level": {
            "const": "A"
          },
          "license_id": {
            "enum": [
              "CC0-1.0",
              "CC-BY-2.0",
              "CC-BY-3.0",
              "CC-BY-4.0",
              "MIT",
              "Apache-2.0",
              "BSD-2-Clause",
              "BSD-3-Clause"
            ]
          }
        },
        "required": [
          "rights_level",
          "license_id"
        ]
      },
      "then": {
        "properties": {
          "rights_assertion_scope": {
            "enum": [
              "exact_text_and_version",
              "exact_metadata_file_and_version"
            ]
          }
        }
      }
    }
  ]
}
