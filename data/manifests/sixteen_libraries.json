{
  "schema_version": 3,
  "title": "RONIN 16-domain × General/HKD corpus admission gate",
  "policy": {
    "required_library_count": 32,
    "minimum_train_bytes_per_library": 1048576,
    "target_train_bytes_per_library": 10737418240,
    "balance_ratio_min": 0.5,
    "balance_ratio_max": 2,
    "portfolio_policy": "retrieval_only_not_pretraining",
    "admission_requires": [
      "immutable_revision",
      "anonymous_download",
      "document_level_license",
      "compatible_license",
      "document_provenance",
      "sha256",
      "deduplication",
      "quality_review",
      "pii_and_secret_scan",
      "document_level_split",
      "train_bytes",
      "semantic_density_selection_report",
      "human_sample_quality_review",
      "cross_library_near_deduplication"
    ],
    "no_official_training_until_all_sixteen_admitted": true,
    "minimum_total_train_bytes": 33554432,
    "target_total_train_bytes": 343597383680,
    "storage_strategy": "streaming_source_shards_per_domain_job; never commit corpora or duplicate text to inflate size; upload only model weights and provenance artifacts",
    "scale_note": "Immediate bootstrap floor: 1 MiB of admitted training text per each of 32 libraries (16 domains × General/HKD). Long-term target remains 10 GiB per library; grow incrementally without duplication or rights shortcuts.",
    "hkd_fraction": 0.5,
    "hkd_selection_rule": "Within each of 16 domains, rank eligible documents using RONIN-HKD-0.1; top 50% goes to HKD and bottom 50% to General. Partitions must be disjoint and share the same document-level rights gate.",
    "hkd_scale_rationale": "The 1 MiB floor is an initial bootstrap threshold, not a quality or legal waiver. The 10 GiB per-library target remains the long-term scale objective. A library may remain below the floor or empty when no eligible documents exist; do not pad with duplicates or cross-domain material.",
    "domain_count": 16,
    "library_layout": "16 distinct domains × 2 disjoint partitions (General and HKD) = 32 libraries",
    "no_run_5_until_all_32_libraries_admitted": true,
    "no_official_training_until_all_32_libraries_admitted": true
  },
