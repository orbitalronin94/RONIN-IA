{
  "schema_version": 1,
  "title": "RONIN historical Spanish and verified cryptography candidate selection",
  "updated_at": "2026-11-04",
  "policy": {
    "admission_gate": "G-0",
    "default_training_eligible": false,
    "require_document_level_rights": true,
    "require_edition_and_transcription_rights": true,
    "require_source_revision_and_sha256": true,
    "require_ocr_quality_review": true,
    "require_duplicate_check": true,
    "require_split_by_work": true,
    "rule": "A historical author or public catalogue is a discovery lead, not blanket permission. No candidate enters training until each exact work, edition, translation, transcription and digital object has documented compatible rights."
  },
